#!/usr/bin/env python3
# co2 - systray breathhold timer and co2 tables
# 2026-11-03 18:28
#
# Dependencies:
# - python-pillow
# - python-pystray
#
# Usage:
# (1) Run co2, a breathhold timer will begin
# (2) Press "Stop" on the systray icon when you can no longer hold your breath
# (3) Press "Start CO2 table based on PB",
#     or "Start breathhold" to try for a better PB
#
# There is no persistence.

from time import sleep
# run_detached doesn't work with gtk backend so we have to run our own
# thread in order to run it in the background
from threading import Thread
from PIL import Image, ImageDraw, ImageFont  # dynamic icon image generation
from pystray import Menu, MenuItem, Icon     # tray icon


def create_image(h=0):
    image = Image.new("RGBA", (16, 16), (0, 0, 0, 0))
    dc = ImageDraw.Draw(image)
    dc.text((2, 0), str(h), font=ImageFont.load_default(size=11))
    return image


class Tabler:
    def __init__(self):
        self.istop = MenuItem('Stop', self.on_stop)
        self.istart = MenuItem('Start breathhold', self.on_start)
        self.itable = MenuItem('Start CO2 table based on PB', self.on_table)
        self.iquit = MenuItem('Quit', self.on_quit)
        self.menu = Menu(self.istop, self.istart, self.itable, self.iquit)
        self.tray = Icon(
            'co2', create_image(), 'co2 tables tool', self.menu)
        Thread(target=self.tray.run, daemon=True).start()
        self.pb = 0
        self.limit = 0
        self.rounds_max = 7
        self.rounds = 0
        self.is_recuperating = False
        self.run()

    def calc_co2rec(self):
        return max(
            10,
            (self.pb // 3) - (self.pb // 20) * (self.rounds_max - self.rounds))

    def calc_co2hold(self):
        return self.pb // 2

    def calc_text(self):
        t = "Release" if self.is_recuperating else "Hold"
        t += f" {self.limit}s" if self.limit else ""
        return t

    def run(self):
        self.just_started = True
        while True:
            if self.just_started:
                self.tray.notify(self.calc_text())
                self.just_started = False
                self.in_progress = True
                self.i = 0
            sleep(1)
            if self.in_progress:
                self.i += 1
                self.tray.icon = create_image(self.i)
                if self.limit and self.i >= self.limit:
                    self.is_recuperating = not self.is_recuperating
                    if self.rounds > 0:
                        self.rounds -= 1
                        self.limit = (self.calc_co2rec()
                                      if self.is_recuperating else
                                      self.calc_co2hold())
                        self.just_started = True
                    else:
                        self.limit = 0
                        self.in_progress = False
                        self.set_idle_icon()

    def on_quit(self, icon, item):
        icon.stop()
        exit(0)

    def set_idle_icon(self):
        self.tray.icon = create_image('O')

    def on_stop(self, icon, item):
        self.in_progress = False
        notif = f"Held for {self.i}"
        if self.pb != 0 and self.i > self.pb and not self.is_recuperating:
            notif += "\nNew personal best (PB)"
        self.pb = self.i
        self.tray.notify(notif)
        self.set_idle_icon()

    def on_start(self, icon, item):
        self.just_started = True

    def on_table(self, icon, item):
        if self.pb < 2:
            self.tray.notify("CO2 table calculation requires a PB > 2")
            return
        self.limit = self.calc_co2hold()
        self.rounds = self.rounds_max
        self.just_started = True


def main():
    Tabler()


if __name__ == '__main__':
    main()
