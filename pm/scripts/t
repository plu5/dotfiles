#!/usr/bin/env bash
# translate-shell wrapper
# 2025-11-29 01:09
#
# Dependencies:
# - translate-shell (trans)
#
# Usage:
# `t translate this into french`
# `t -t de translate this into german`
# `t .de text` utile pour le dictionnaire si tu envoies un seul mot.
# (équivalent à `t -hl de -t de text`)
# mais si tu veux traduire depuis une autre langue, utilise `t -t de text`.
# certaines langues n'ont pas de de dictionnaire malheureusement (la, zh)

# options: apertium aspell auto bing google hunspell spell yandex
# (^ sortie de `trans -S`)
# dictionnaire ne marche pas avec certains, même si je donne -d explicitement
MOTEUR=google
ARGS="-j -no-ansi -show-original n -show-prompt-message n -show-alternatives Y"

set -f  # no glob
if [ "$1" = ".de" ]; then
    trans -e "$MOTEUR" -hl de -t de $ARGS ${@:2}
elif [ "$1" = ".en" ]; then
    trans -e "$MOTEUR" -hl en -t en -s en $ARGS ${@:2}
else
    trans -e "$MOTEUR" -hl fr -t fr $ARGS $@
fi
set +f
